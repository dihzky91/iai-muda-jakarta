# Optional: Gemini API key for future AI features.
# This project can run locally without setting it.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Database connection
DB_HOST="localhost"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="iai_muda_jakarta"
DB_PORT="3306"

# JWT Auth — change this to a long random string in production!
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="8h"

# Initial superadmin password (used by npm run seed)
SUPERADMIN_PASSWORD="change-this-password"
